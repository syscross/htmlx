// routes/users/[id].serverx

// 1. Server-only execution block (Runs on Rust/WASM edge runtime, never leaks to client)
@server {
    // URL params and context injected implicitly
    let user_id = $params.id;
    let auth = $req.headers.get("Authorization");

    // Native DB query / Rust-style error handling
    let user = db::query("SELECT id, name, role FROM users WHERE id = ?", user_id)?;
}

// 2. Pure REST fallback (if client requests application/json)
@api:delete {
    db::execute("DELETE FROM users WHERE id = ?", $params.id)?;
    return Response::ok({ status: "deleted" });
}

// 3. View template (Standard htmlx syntax consuming @server variables)
layout "layouts/main.htmlx"

main #profile .container {
  header {
    h1 { $user.name }
    span .badge { $user.role }
  }

  section .actions {
    // Interacts cleanly with the REST endpoint defined above
    button .btn-danger (delete=$req.path, target="#profile", swap="remove") {
      "Delete Account"
    }
  }
}