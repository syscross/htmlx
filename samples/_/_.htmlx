// Main entrypoint: define structure and pass props
html {
  head(title: "SysCross Spec", lang: "en");
  body(theme: "minimal", dark: true, sidebar: false);
}

// Head definition: consumes $title directly
head {
  meta(charset: "utf-8")
  meta(name="viewport", content="width=device-width, initial-scale=1.0")
  title { $title }
  link(rel="stylesheet", href="/style.css")
}

// Body definition: consumes $theme, $dark, and $sidebar
body.theme-$theme {
  header#top.header.flex-between {
    .logo {
      span.brand { "SYS" }
      span.accent { "X" }
    }

    // Check boolean flags
    if $dark {
      span.badge { "Dark Mode" }
    }
  }

  // Conditional component rendering
  if $sidebar {
    aside.sidebar {
      nav {
        a(href="/docs") { "Docs" }
        a(href="/specs") { "Specs" }
      }
    }
  }

  main#content.container {
    section.hero {
      h1 { "SysCross Engine" }
      p { "Active Theme: " $theme }
    }

    hr

    // Tag name omitted: defaults to div
    .grid-cards {
      .card#txx-info {
        h3 { "cargo-txx" }
        p { "C++ to TXX helper parser." }
      }
      .card#rsx-info {
        h3 { "cargo-rsx" }
        p { "TXX to RSX to Safe Rust transpile pipeline." }
      }
    }
  }

  footer.footer {
    p { "© 2026 SysCross. All rights reserved." }
  }

  script(src="/bundle.js")
}