// Main entrypoint
html {
  head(title: "SysCross Spec", lang: "en");
  body(theme: "minimal", dark: true);
}

head {
  meta(charset: "utf-8")
  title { $title }
}

// Spaced selectors: clean and readable
body .theme-$theme {
  header #top .header .flex-between {
    .logo {
      span .brand { "SYS" }
      span .accent { "X" }
    }

    if $dark {
      span .badge { "Dark Mode" }
    }
  }

  main #content .container {
    // Multiple classes separated by spaces
    section .hero .text-center {
      h1 { "SysCross Engine" }
      p .lead { "Clean markup without clutter" }
    }

    hr

    // Div with multiple utility classes
    .grid-cards .gap-4 .p-2 {
      .card #txx-info {
        h3 { "cargo-txx" }
        p { "C++ to TXX helper parser." }
      }
    }
  }
}