// 1. 엔트리포인트 (main 함수처럼 문서 구조를 바인딩)
html(lang="ko") {
  head;
  body;
}

// 2. 메타데이터 정의 블록
head {
  meta(charset="utf-8")
  meta(name="viewport", content="width=device-width, initial-scale=1.0")
  title { "SysCross Dev" }
  link(rel="stylesheet", href="/style.css")
}

// 3. 뷰 본문 정의 블록 (0-indent로 쾌적하게 시작)
body.dark-theme {
  header#top.header.flex-between {
    .logo {
      span.brand { "SYS" }
      span.accent { "X" }
    }
    nav.nav-links {
      a(href="/docs") { "Docs" }
      a(href="/specs") { "Specs" }
      a(href="https://github.com/syscross") { "GitHub" }
    }
  }

  main#content.container {
    section.hero {
      h1 { "Next-gen Migration Helper" }
      p.lead {
        "C++에서 Rust로 넘어가는 파이프라인\n"
        "문법적 피로감을 걷어낸 독자 규격 툴체인"
      }
      .btn-group {
        button.btn.btn-primary { "Get Started" }
        button.btn.btn-ghost { "View on GitHub" }
      }
    }

    hr

    section.grid-cards {
      .card#txx-info {
        h3 { "cargo-txx" }
        p { "C++의 복잡성을 걸러내고 Rust 규율을 덧입히는 단계" }
      }
      .card#rsx-info {
        h3 { "cargo-rsx" }
        p { "단계별 초기화를 허용하며 안전한 Rust로 안착시키는 단계" }
      }
    }
  }

  footer.footer {
    p { "© 2026 SysCross. All rights reserved." }
  }

  script(src="/bundle.js")
}